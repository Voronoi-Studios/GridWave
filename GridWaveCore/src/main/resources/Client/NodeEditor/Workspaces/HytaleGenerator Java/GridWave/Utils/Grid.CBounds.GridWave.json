{
  "Id": "Grid.CBounds.GridWave",
  "Title": "Grid Bounds Generator",
  "Color": "Orange",
  "Description" : "Creates bounds extending from the position, offset * repeat times in each direction. If centered is true, the bounds will be centered on the position.",
  "Content" : [
    {
      "Id": "Centered",
      "Type": "Checkbox",
      "Options": {
        "Label": "Centered",
        "Default" : true
      }
    }
  ],
  "Outputs": [
    {
      "Id": "PointConnection",
      "Type": "Integer.Vector3d.Connection",
      "Color": "Orange",
      "Multiple" : false,
      "Label" : "Position"
    },
    {
      "Id": "OffsetConnection",
      "Type": "Integer.Vector3d.Connection",
      "Color": "Orange",
      "Multiple" : false,
      "Label" : "Offset"
    },
    {
      "Id": "RepeatConnection",
      "Type": "Integer.Vector3d.Connection",
      "Color": "Orange",
      "Multiple" : false,
      "Label" : "Repeat"
    }
  ],
  "Inputs": [
    {
      "Id": "Output",
      "Type": "CBounds.Connection",
      "Color": "Orange"
    }
  ],
  "Schema": {
    "Type" : "Grid",
    "Position" : {
      "Node" : "Vectors",
      "Pin" : "PointConnection"
    },
    "Offset" : {
      "Node" : "Vectors",
      "Pin" : "OffsetConnection"
    },
    "Repeat" : {
      "Node" : "Vectors",
      "Pin" : "RepeatConnection"
    },
    "Centered" : "Centered"
  }
}